{
  "name": "Jade Schema",
  "scopeName": "source.jade",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#relations"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "match": "\\b(model|table|timestamps|relations|options)\\b",
          "name": "keyword.control.jade"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(Integer|String|Text|Boolean|Timestamp|Date|UUID|CUID|NanoID|Float|Decimal|BigInt|JSON|Enum)\\b",
          "name": "support.type.primitive.jade"
        },
        {
          "match": "\\b(Schema|Entity|SoftDelete|Audit|Encryption|Events)\\b",
          "name": "support.type.class.jade"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "match": "(\\?|!)",
          "name": "keyword.operator.modifier.jade"
        },
        {
          "match": ":(primaryKey|autoIncrement|notNull|unique|default|foreignKey|nullable|inValues|defaultNow|encrypted)\\b",
          "name": "support.type.modifier.jade"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.jade",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.jade"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.jade",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.jade"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
          "name": "constant.numeric.jade"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "match": "--.*$",
          "name": "comment.line.double-dash.jade"
        }
      ]
    },
    "relations": {
      "patterns": [
        {
          "match": "\\b(belongsTo|hasMany|hasOne|hasAndBelongsToMany|hasManyThrough)\\b",
          "name": "support.type.relation.jade"
        }
      ]
    }
  }
}
